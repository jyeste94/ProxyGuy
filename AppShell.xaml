<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ProxyGuy.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ProxyGuy"
    Shell.FlyoutBehavior="Disabled"
    Title="ProxyGuy">

    <ShellContent
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        ContentTemplate="{DataTemplate local:Views.CertificatePage}"
        Route="CertificatePage" />

    <ShellContent
        ContentTemplate="{DataTemplate local:Views.MapLocalPage}"
        Route="MapLocalPage" />

    <ShellContent
        ContentTemplate="{DataTemplate local:Views.SslProxyingPage}"
        Route="SslProxyingPage" />

    <ShellContent
        ContentTemplate="{DataTemplate local:Views.BreakpointPage}"
        Route="BreakpointPage" />

    <ShellContent
        ContentTemplate="{DataTemplate local:Views.PhpIntegrationPage}"
        Route="PhpIntegrationPage" />

</Shell>
