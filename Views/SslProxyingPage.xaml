<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProxyGuy.ViewModels"
             x:Class="ProxyGuy.Views.SslProxyingPage"
             Title="SSL Proxying List">
    <ContentPage.BindingContext>
        <vm:SslProxyingViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Info Banner -->
        <Border Margin="16,16,16,0" Style="{StaticResource InfoBannerStyle}">
            <Label Text="Add hosts to this list to enable SSL decryption for them. If the list is empty, ALL hosts are decrypted." 
                   TextColor="{StaticResource InfoTextColor}" FontSize="13"/>
        </Border>

        <!-- Add Rule -->
        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Padding="16,12" Margin="16,16,16,0">
             <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                 <VerticalStackLayout Spacing="4">
                     <Label Text="Host Pattern (supports wildcards, e.g. *.google.com)" Style="{StaticResource SectionTitleLabelStyle}"/>
                     <Entry Text="{Binding NewHostPattern}" Placeholder="e.g. api.example.com" />
                 </VerticalStackLayout>
                 
                 <Button Grid.Column="1" 
                         Text="Add Host" 
                         Command="{Binding AddRuleCommand}" 
                         VerticalOptions="End"
                         Style="{StaticResource PrimaryButtonStyle}"/>
             </Grid>
        </Border>

        <!-- List -->
        <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}" Margin="16">
            <CollectionView ItemsSource="{Binding Rules}">
                <CollectionView.Header>
                    <Label Text="Included Hosts" Style="{StaticResource HeadlineLabelStyle}" Margin="0,0,0,8"/>
                </CollectionView.Header>
                <CollectionView.EmptyView>
                    <Label Text="No hay hosts configurados. Se descifraran todos por defecto."
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Style="{StaticResource BodyLabelStyle}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SubtleCardStyle}" Padding="12" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                <Switch IsToggled="{Binding IsEnabled}" />
                                
                                <Label Grid.Column="1" Text="{Binding HostPattern}" FontAttributes="Bold" LineBreakMode="TailTruncation" VerticalOptions="Center"/>
                                
                                <Button Grid.Column="2" 
                                        Text="Remove" 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveRuleCommand}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource DangerGhostButtonStyle}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
    </Grid>
</ContentPage>
