<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProxyGuy.ViewModels"
             x:Class="ProxyGuy.Views.RequestComposerPage"
             Title="Request Composer">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Cerrar"
                     Priority="0"
                     Order="Primary"
                     Clicked="OnCloseClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">
        <!-- Header bar with close button -->
        <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                <Label Text="Replay / Compose"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimaryColor}" />
                <Label Grid.Column="1"
                       Text="Editar y reenviar peticiones"
                       VerticalOptions="Center"
                       TextColor="{StaticResource TextSecondaryColor}" />
                <Button Grid.Column="2"
                        Text="Cerrar"
                        Style="{StaticResource GhostButtonStyle}"
                        Clicked="OnCloseClicked" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- URL + Method -->
                <Border Style="{StaticResource SubtleCardStyle}">
                    <Grid ColumnDefinitions="120,*" ColumnSpacing="12">
                        <Picker Grid.Column="0"
                                Title="Method"
                                ItemsSource="{Binding MethodOptions}"
                                SelectedItem="{Binding Method, Mode=TwoWay}" />
                        <Entry Grid.Column="1" Placeholder="https://api.example.com/path"
                               Text="{Binding Url, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <!-- Headers -->
                <Border Style="{StaticResource SubtleCardStyle}">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="Headers" Style="{StaticResource SectionTitleLabelStyle}" />
                            <Button Text="+"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding AddHeaderCommand}" />
                        </HorizontalStackLayout>
                        <CollectionView ItemsSource="{Binding Headers}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8" Padding="0,4">
                                        <Entry Grid.Column="0" Placeholder="Key" Text="{Binding Key, Mode=TwoWay}" />
                                        <Entry Grid.Column="1" Placeholder="Value" Text="{Binding Value, Mode=TwoWay}" />
                                        <Button Grid.Column="2"
                                                Text="X"
                                                WidthRequest="32"
                                                HeightRequest="32"
                                                Style="{StaticResource DangerGhostButtonStyle}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveHeaderCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Body -->
                <Border Style="{StaticResource SubtleCardStyle}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Body" Style="{StaticResource SectionTitleLabelStyle}" />
                        <Editor HeightRequest="180" Text="{Binding Body, Mode=TwoWay}" Style="{StaticResource CodeEditorStyle}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Actions -->
                <HorizontalStackLayout Spacing="12">
                    <Button Text="Send" Command="{Binding SendCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                </HorizontalStackLayout>

                <!-- Status -->
                <Border Style="{StaticResource SubtleCardStyle}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding StatusMessage}" FontAttributes="Bold" />
                        <Editor HeightRequest="200" Text="{Binding ResponsePreview}" IsReadOnly="True" Style="{StaticResource CodeEditorStyle}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
